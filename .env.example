# =============================================================================
# Walz Travels — Environment Variables
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to git.
# =============================================================================

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://www.walztravels.com

# ── Database (Supabase Postgres) ──────────────────────────────────────────────
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-eu-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.[project-ref]:[password]@aws-0-eu-west-2.pooler.supabase.com:5432/postgres

# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://[project-ref].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...     # NEVER expose to the browser

# ── Admin Auth ────────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
JWT_ADMIN_SECRET=change-me-to-a-random-64-char-secret

# Fallback env-var super-admin (can also use Staff table instead)
ADMIN_EMAILS=contact@walztravels.com
ADMIN_PASSWORD_HASH=                 # bcrypt hash; or use ADMIN_PASSWORD for dev only
ADMIN_PASSWORD=                      # plaintext only for local dev — set HASH in production

# ── Cron Jobs ─────────────────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
CRON_SECRET=change-me-to-a-random-secret

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Flutterwave ───────────────────────────────────────────────────────────────
FLW_SECRET_KEY=FLWSECK_LIVE-...
FLW_PUBLIC_KEY=FLWPUBK_LIVE-...
FLW_WEBHOOK_SECRET=...

# ── AXA Partners Travel Insurance ────────────────────────────────────────────
# Real values come from your AXA Partners referent (Auth0 client credentials).
# When set, AXA is used as the primary insurance provider.
# Battleface remains active as a fallback when AXA is not configured.
AXA_CLIENT_ID=
AXA_CLIENT_SECRET=
# Optional — defaults shown below (only set if your referent gives you different URLs)
AXA_API_BASE=https://apis.axa-assistance.com
AXA_AUTH_URL=https://auth.api.axapartners.com/oauth/token

# ── Battleface (Travel Insurance — fallback) ──────────────────────────────────
# Used when AXA_CLIENT_ID / AXA_CLIENT_SECRET are not set.
BATTLEFACE_API_URL=
BATTLEFACE_BEARER_TOKEN=

# ── Paga Collect ──────────────────────────────────────────────────────────────
# SECURITY: Rotate these before use if they were ever shared in a chat / log
PAGA_PUBLIC_KEY=
PAGA_SECRET_KEY=
PAGA_HMAC_KEY=
# Optional — defaults to https://collect.paga.com (server-to-server Collect API)
PAGA_COLLECT_URL=https://collect.paga.com
# Optional — defaults to https://checkout.paga.com (browser-hosted checkout page)
PAGA_CHECKOUT_URL=https://checkout.paga.com

# ── Resend (Email) ────────────────────────────────────────────────────────────
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=noreply@walztravels.com

# ── Redis (Optional — app degrades gracefully if not set) ─────────────────────
REDIS_URL=redis://default:[password]@[host]:6379

# ── Sabre (Flights) ───────────────────────────────────────────────────────────
SABRE_CLIENT_ID=
SABRE_CLIENT_SECRET=
SABRE_API_URL=https://api.cert.sabre.com

# ── Hotelbeds (Hotels & Activities) ──────────────────────────────────────────
HOTELBEDS_API_KEY=
HOTELBEDS_SECRET=
HOTELBEDS_API_URL=https://api.test.hotelbeds.com

# ── Aviapages — private aviation (server-only, never NEXT_PUBLIC_) ────────────
AVIAPAGES_ENABLED=false
AVIAPAGES_API_KEY=
AVIAPAGES_BASE_URL=https://api.aviapages.com/v3
AVIAPAGES_REQUEST_TIMEOUT_MS=20000

# ── ComfortPass — airport concierge services ──────────────────────────────────
COMFORTPASS_ENABLED=false
COMFORTPASS_ENV=sandbox
COMFORTPASS_PRODUCTION_API_KEY=
COMFORTPASS_SANDBOX_API_KEY=

# ── Viator (Tours & Activities) ──────────────────────────────────────────────
VIATOR_API_KEY=
# sandbox | production  — only switch to production after Viator account is verified
VIATOR_API_ENV=sandbox
# Feature flags — set all three to 'true' to enable Viator in the marketplace
# VIATOR_ACTIVITIES_ENABLED: master switch (all Viator functionality)
# VIATOR_CUSTOMER_SEARCH_ENABLED: show Viator results on the public /activities page
# VIATOR_ADMIN_BOOKING_ENABLED: allow admin to book via Viator in the quoting workflow
VIATOR_ACTIVITIES_ENABLED=false
VIATOR_CUSTOMER_SEARCH_ENABLED=false
VIATOR_ADMIN_BOOKING_ENABLED=false

# ── Google (Analytics / OAuth) ───────────────────────────────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Release 4E — Jade Commerce Analytics
JADE_COMMERCE_ANALYTICS_ENABLED=true

# ── Recovery Engine ───────────────────────────────────────────────────────────
RECOVERY_ENGINE_ENABLED=false
RECOVERY_EMAIL_ENABLED=false
RECOVERY_WHATSAPP_ENABLED=false
RECOVERY_PORTAL_ENABLED=false
RECOVERY_MAX_AUTO_CONTACTS=2

# ── Jade Automation (all false = safe default) ────────────────────────────────
JADE_AUTOMATED_FOLLOWUP_ENABLED=false
JADE_PROPOSAL_AUTOMATION_ENABLED=false
JADE_PROPOSAL_AUTO_SEND_ENABLED=false
JADE_CHECKOUT_HANDOFF_ENABLED=false
PROPOSAL_AUTO_SEND_THRESHOLD=5000
AUTOMATION_STAFF_REVIEW_THRESHOLD=2000
# Kill switches — changing these to true requires a redeploy. See /admin/settings for runtime control.
# JADE_AUTOMATED_FOLLOWUP_ENABLED: master switch for all recovery/follow-up automation
# JADE_PROPOSAL_AUTOMATION_ENABLED: master switch for proposal automation
# JADE_PROPOSAL_AUTO_SEND_ENABLED: enables auto-send of proposals (requires JADE_PROPOSAL_AUTOMATION_ENABLED=true)
# JADE_CHECKOUT_HANDOFF_ENABLED: enables automated checkout handoff to Jade
# PROPOSAL_AUTO_SEND_THRESHOLD: trip value (in trip currency) above which auto-send is BLOCKED
# AUTOMATION_STAFF_REVIEW_THRESHOLD: trip value above which STAFF_APPROVAL_REQUIRED (not auto-send)

# ── Release 7.4 — Loyalty & Referrals ────────────────────────────────────────
# Miles awarded per unit of booking currency on CONFIRMED bookings.
# Change this value in config — never hardcode a business promise in source.
MILES_PER_CURRENCY_UNIT=1

# ── Release 7.5 — Experiment Infrastructure ───────────────────────────────────
# Set to 'true' to activate A/B experiment assignments.
# When false (default), assignVariant always returns the control variant and
# isInExperiment always returns false — safe UX variants only; never use for
# security, payment, or ownership decisions.
EXPERIMENT_ENABLED=false
